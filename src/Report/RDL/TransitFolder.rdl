            <Textbox Name="FooterPrinted">
              <CanGrow>false</CanGrow>
              <KeepTogether>true</KeepTogether>
              <Paragraphs>
                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value>="Printed on " &amp; Format(Globals!ExecutionTime, "g")</Value>
                      <Style>
                        <FontFamily>Segoe UI</FontFamily>
                        <FontSize>7pt</FontSize>
                        <FontStyle>Italic</FontStyle>
                      </Style>
                    </TextRun>
                  </TextRuns>
